PORT=4000

# --- AI providers (all optional, tried in this order with automatic fallback) ---
# Powers both the report's bug explanations and the in-report chat panel.
# Groq is recommended: free, very fast, and good quality.
GROQ_API_KEY="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"
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter: free-tier models, used if Groq is unset or rate-limited.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Gemini: Google's free tier, third fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# If none of the above are set, WebGuard still works fully — bug
# explanations fall back to rule-based text and the chat panel tells
# the user no provider is configured, instead of erroring.

# Optional: only set this if you need Puppeteer to use a specific Chrome/
# Chromium binary instead of the one it installs for itself. Leave blank
# on most machines.
PUPPETEER_EXECUTABLE_PATH=
